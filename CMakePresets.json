{
  "version": 3,
  "configurePresets": [{
    "name": "windows-vs2019",
    "displayName": "Qt 5.15.2 / VS 2019 / x64 / MD",
    "generator": "Visual Studio 16 2019",
    "architecture": "x64",
    "binaryDir": "${sourceDir}/build",
    "cacheVariables": {
      "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
      "VCPKG_HOST_TRIPLET": "x64-windows",
      "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed",
      "VCPKG_MANIFEST_MODE": "OFF",
      "VCPKG_APPLOCAL_DEPS": "OFF",
      "Qt5_DIR": "$env{Qt5_DIR}/lib/cmake/Qt5"
    }
  }],
  "buildPresets": [{"name":"release", "configurePreset":"windows-vs2019", "configuration":"Release"}]
}
